{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-pos",
  "version": "0.1.0",
  "identifier": "com.yorgenis.desktop-pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4MTZDQkIzQkI5MzQ1NzIKUldSeVJaTzdzOHNXbUhJSzFrNHZCTWZ4bDVScjhQVHZRWTVGelo5RGFQamMwalNWNVdhWHBHSEIK",
      "endpoints": [
        "https://firebasestorage.googleapis.com/v0/b/schopy-pos-technology.appspot.com/o/updater.json?alt=media"
      ],
      "dialog": false
    }
  },
  "app": {
    "windows": [
      {
        "title": "Schopy POS",
        "width": 1280,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
